{
  "name": "voidex",
  "private": true,
  "version": "0.1.0",
  "description": "VOIDEX — a unified personal digital space (OS shell, account, system apps).",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @voidex/web build && pnpm --filter @voidex/server build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @voidex/shared test && pnpm --filter @voidex/server test",
    "test:e2e": "pnpm --filter @voidex/web test:e2e",
    "db:migrate": "pnpm --filter @voidex/server db:migrate",
    "db:generate": "pnpm --filter @voidex/server db:generate",
    "start": "pnpm --filter @voidex/server start"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
