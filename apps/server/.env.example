# ---- VOIDEX server configuration --------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://voidex:voidex@localhost:5432/voidex

# Secrets — REQUIRED in production (generate with: openssl rand -base64 48)
# AUTH_ACCESS_SECRET=
# AUTH_TOKEN_PEPPER=

# Internal mail domain (addresses look like name@MAIL_DOMAIN)
MAIL_DOMAIN=voidops.ru

# SMS delivery for phone verification.
#   console  — development only: codes are logged and shown on screen, nothing is sent.
#              The server refuses to start with it when NODE_ENV=production.
#   disabled — no SMS gateway yet (production before SMS is connected): phone
#              verification is refused with 503, no code is ever issued or faked.
#   otpcom   — otp.com hosted OTP (production): OTP_API_KEY. otp.com makes, sends and
#              checks the code; the channel comes from the app routing in the otp.com
#              dashboard. Production accepts only live server keys (otp_live_…); a
#              sandbox key (otp_test_…, fixed code 123456) is for local testing only.
#   twilio   — TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM
#   smsru    — SMSRU_API_ID
SMS_PROVIDER=console
# OTP_API_KEY=   (never commit a real key; in production it comes from GitHub Secrets)

# Behind a reverse proxy (nginx, a load balancer): trust X-Forwarded-* headers.
TRUST_PROXY=false
# Origins of native shells allowed to call the API (comma separated), e.g. capacitor://localhost
ALLOWED_ORIGINS=
# Development / e2e only: multiplies per-IP rate limits (many test users share one IP).
# Must stay 1 in production (the server refuses to start otherwise).
RATE_LIMIT_SCALE=1
# Serve the built web client from this folder (production single-origin deploy).
# WEB_DIST=../web/dist
